# --- Secrets and local credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
credentials.json
secrets.*

# --- Unreal Engine: generated by the engine, editor, or build ---
# Based on github/gitignore UnrealEngine.gitignore, scoped to any depth.
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
**/Build/*
!**/Build/*/
**/Build/*/**
!**/Build/*/PakBlacklist*.txt
!**/Build/**/*.ico
*_BuiltData.uasset
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Compiled artifacts
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa
*.pdb

# Packaged builds
/dist/
/unreal/Packaged/
/unreal/Windows/
/unreal/Linux/
/unreal/Mac/
*.dSYM/

# Assets whose license does not allow redistribution in this repository.
# See docs/licensing-review.md before adding anything elsewhere under Content/.
/unreal/Content/Licensed/
/unreal/Content/Fab/
/unreal/Content/Megascans/
/unreal/Plugins/Licensed/

# Source art kept outside Git unless explicitly promoted
/unreal/SourceArt/

# Generated by ModelContextProtocol.GenerateClientConfig; machine-local for now
/unreal/.mcp.json

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
/python/build/
/python/dist/

# Hidden competition data must never enter this repository
/scenarios/private/

# Simulation and evaluation output
/runs/
*.telemetry.jsonl

# --- Editors and OS ---
.vs/
.idea/
.vscode/
*.user
Thumbs.db
Desktop.ini
.DS_Store

# --- Claude Code local state ---
.claude/settings.local.json
CLAUDE.local.md
