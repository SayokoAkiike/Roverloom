;; Sandbox profile for every Unreal process the night starts on the Mac mini (sandbox-exec -f), as the night user.
;; install-night-area.sh fills the two lists below from rd/charter.json, mini.write_protected and mini.read_protected,
;; with ~ expanded for the night user. The night user's own permissions already keep the owner's files out of reach;
;; this profile is a second layer. Outbound network is limited to loopback. Binds and inbound traffic cannot be
;; limited here without breaking MCP (measured 2026-11-07); the firewall handles ports 1985 and 8558.
(version 1)
(allow default)
(deny file-write*
@DENY_WRITE@)
(deny file-read*
@DENY_READ@)
(deny network-outbound (remote ip "*:*"))
(allow network-outbound (remote ip "localhost:*"))
