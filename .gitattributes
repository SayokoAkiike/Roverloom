# Normalize text; keep platform-specific script endings stable.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unreal text formats stay in plain Git and remain diffable.
*.uproject text
*.uplugin text
*.ini text
*.cpp text
*.h text
*.cs text

# Unreal binary assets cannot be merged, so they are also lockable.
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable

# 3D source
*.fbx filter=lfs diff=lfs merge=lfs -text
