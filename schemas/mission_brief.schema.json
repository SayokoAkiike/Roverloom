{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roverloom.invalid/schemas/mission_brief.schema.json",
  "title": "Mission brief",
  "description": "Everything an agent may know before the mission. No rocks, soil, faults, or noise settings.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "mission_id": {
      "type": "string"
    },
    "start_pose": {
      "$ref": "common.schema.json#/$defs/pose"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position_m": {
            "$ref": "common.schema.json#/$defs/vector3"
          },
          "radius_m": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "position_m",
          "radius_m"
        ],
        "additionalProperties": false
      }
    },
    "time_limit_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "energy_limit_wh": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "control_period_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_speed_mps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_yaw_rate_radps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "body_radius_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sensor_max_range_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "extent_min_xy": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "extent_max_xy": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "science_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "position_m": {
            "$ref": "common.schema.json#/$defs/vector3"
          },
          "radius_m": {
            "type": "number"
          },
          "prior_value": {
            "type": "number"
          },
          "inspect_s": {
            "type": "number"
          },
          "collect_s": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "position_m",
          "radius_m",
          "prior_value",
          "inspect_s",
          "collect_s"
        ],
        "additionalProperties": false
      }
    },
    "base": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "position_m": {
          "$ref": "common.schema.json#/$defs/vector3"
        },
        "radius_m": {
          "type": "number"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "position_m",
        "radius_m",
        "required"
      ],
      "additionalProperties": false
    },
    "data_windows": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "period_s": {
          "type": "number"
        },
        "open_s": {
          "type": "number"
        },
        "offset_s": {
          "type": "number"
        }
      },
      "required": [
        "period_s",
        "open_s",
        "offset_s"
      ],
      "additionalProperties": false
    },
    "transmit_s_per_item": {
      "type": [
        "number",
        "null"
      ]
    },
    "success_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "can_collect": {
      "type": "boolean"
    },
    "battery_capacity_wh": {
      "type": "number"
    },
    "declared_uncertainty": {
      "description": "What the mission claims about sensor errors. May be wrong.",
      "type": "object",
      "properties": {
        "inspection_noise_sd": {
          "type": "number",
          "minimum": 0
        },
        "pose_noise_m": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "inspection_noise_sd",
        "pose_noise_m"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "mission_id",
    "start_pose",
    "targets",
    "time_limit_s",
    "energy_limit_wh",
    "control_period_s",
    "max_speed_mps",
    "max_yaw_rate_radps",
    "body_radius_m",
    "sensor_max_range_m",
    "extent_min_xy",
    "extent_max_xy"
  ],
  "additionalProperties": false
}
