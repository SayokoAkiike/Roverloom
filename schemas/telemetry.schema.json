{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roverloom.invalid/schemas/telemetry.schema.json",
  "title": "Telemetry record",
  "description": "One ground-truth line of a JSON Lines log, consumed by evaluation.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "time_s": { "type": "number", "minimum": 0 },
    "pose": { "$ref": "common.schema.json#/$defs/pose" },
    "linear_velocity_mps": { "$ref": "common.schema.json#/$defs/vector3" },
    "battery_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "energy_used_wh": { "type": "number", "minimum": 0 }
  },
  "required": [
    "schema_version",
    "time_s",
    "pose",
    "linear_velocity_mps",
    "battery_fraction",
    "energy_used_wh"
  ],
  "additionalProperties": false
}
