{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roverloom.invalid/schemas/event.schema.json",
  "title": "Mission event",
  "description": "One ground-truth event in a JSON Lines log.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "time_s": {
      "type": "number",
      "minimum": 0
    },
    "type": {
      "enum": [
        "mission_started",
        "target_reached",
        "fault_started",
        "fault_ended",
        "collision",
        "watchdog_stop",
        "watchdog_cleared",
        "source_changed",
        "agent_error",
        "mission_ended",
        "task_started",
        "task_completed",
        "task_rejected",
        "task_failed",
        "data_window_opened",
        "data_window_closed"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "seq",
    "time_s",
    "type",
    "data"
  ],
  "additionalProperties": false
}
