{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roverloom.invalid/schemas/skill_plan.schema.json",
  "title": "Skill plan",
  "description": "A plan as data: named skills from a fixed list with validated parameters. Never executable code.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "skill": { "const": "go_to" },
              "x_m": { "type": "number" },
              "y_m": { "type": "number" },
              "radius_m": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["skill", "x_m", "y_m"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "skill": { "const": "go_to_next_target" }
            },
            "required": ["skill"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "skill": { "const": "wait" },
              "duration_s": { "type": "number", "minimum": 0 }
            },
            "required": ["skill", "duration_s"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "skill": { "const": "turn_to" },
              "yaw_rad": { "type": "number" }
            },
            "required": ["skill", "yaw_rad"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["schema_version", "steps"],
  "additionalProperties": false
}
