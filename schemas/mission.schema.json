{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roverloom.invalid/schemas/mission.schema.json",
  "title": "Mission",
  "description": "Objectives and limits, independent of the simulation backend. Objectives are completed in order.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "terrain_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "start_pose": {
      "$ref": "common.schema.json#/$defs/pose"
    },
    "time_limit_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "energy_limit_wh": {
      "description": "Optional energy budget. Exceeding it ends the mission.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "reach_position"
          },
          "position_m": {
            "$ref": "common.schema.json#/$defs/vector3"
          },
          "radius_m": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "type",
          "position_m",
          "radius_m"
        ],
        "additionalProperties": false
      }
    },
    "science": {
      "description": "Science campaign. true_value is hidden from agents until inspection.",
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "position_m": {
                "$ref": "common.schema.json#/$defs/vector3"
              },
              "radius_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "prior_value": {
                "type": "number",
                "minimum": 0
              },
              "true_value": {
                "type": "number",
                "minimum": 0
              },
              "inspect_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "collect_s": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "position_m",
              "radius_m",
              "prior_value",
              "true_value",
              "inspect_s",
              "collect_s"
            ],
            "additionalProperties": false
          }
        },
        "base": {
          "type": "object",
          "properties": {
            "position_m": {
              "$ref": "common.schema.json#/$defs/vector3"
            },
            "radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "position_m",
            "radius_m",
            "required"
          ],
          "additionalProperties": false
        },
        "data_windows": {
          "description": "Periodic ground passes for science data. Commands use the separate command link.",
          "type": "object",
          "properties": {
            "period_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "open_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "offset_s": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "period_s",
            "open_s",
            "offset_s"
          ],
          "additionalProperties": false
        },
        "transmit_s_per_item": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "success_value": {
          "type": "number",
          "minimum": 0
        },
        "survey": {
          "description": "Readings carry all the value, and no samples are collected.",
          "type": "boolean"
        }
      },
      "required": [
        "targets",
        "transmit_s_per_item",
        "success_value"
      ],
      "additionalProperties": false
    },
    "reference_energy_wh": {
      "description": "Fixed energy reference for the efficiency part of the score, so that a bigger battery earns nothing by itself.",
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "schema_version",
    "mission_id",
    "terrain_id",
    "start_pose",
    "time_limit_s",
    "objectives"
  ],
  "additionalProperties": false
}
