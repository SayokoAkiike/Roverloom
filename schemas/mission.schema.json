{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roverloom.invalid/schemas/mission.schema.json",
  "title": "Mission",
  "description": "Objectives and limits, independent of the simulation backend. Objectives are completed in order.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "mission_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "terrain_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "start_pose": { "$ref": "common.schema.json#/$defs/pose" },
    "time_limit_s": { "type": "number", "exclusiveMinimum": 0 },
    "energy_limit_wh": {
      "description": "Optional energy budget. Exceeding it ends the mission.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "type": { "const": "reach_position" },
          "position_m": { "$ref": "common.schema.json#/$defs/vector3" },
          "radius_m": { "type": "number", "exclusiveMinimum": 0 }
        },
        "required": ["type", "position_m", "radius_m"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "mission_id",
    "terrain_id",
    "start_pose",
    "time_limit_s",
    "objectives"
  ],
  "additionalProperties": false
}
