{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roverloom.invalid/schemas/submission_metadata.schema.json",
  "title": "Submission metadata",
  "description": "Describes a competition submission.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "agent_class": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "league": {
      "enum": [
        "autonomy",
        "rover_design",
        "full_mission"
      ]
    },
    "license": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "name",
    "authors",
    "agent_class",
    "league"
  ],
  "additionalProperties": false
}
