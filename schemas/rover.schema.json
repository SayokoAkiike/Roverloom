{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roverloom.invalid/schemas/rover.schema.json",
  "title": "Rover",
  "description": "Rover parameters used by the lightweight model. Written by hand or compiled from a rover design.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "rover_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "description": {
      "type": "string"
    },
    "mass_kg": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "body_radius_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "wheel_radius_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_speed_mps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_yaw_rate_radps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_accel_mps2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_yaw_accel_radps2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_climb_slope": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "battery_capacity_wh": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "idle_power_w": {
      "type": "number",
      "minimum": 0
    },
    "rolling_resistance": {
      "type": "number",
      "minimum": 0
    },
    "drive_efficiency": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "turn_power_w_per_radps": {
      "type": "number",
      "minimum": 0
    },
    "base_slip_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.95
    },
    "slope_slip_factor": {
      "type": "number",
      "minimum": 0
    },
    "slip_noise": {
      "type": "number",
      "minimum": 0
    },
    "failed_wheel_yaw_bias_radps": {
      "type": "number",
      "minimum": 0
    },
    "range_sensor": {
      "type": "object",
      "properties": {
        "max_range_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bearings_rad": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        }
      },
      "required": [
        "max_range_m",
        "bearings_rad"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "string"
    },
    "wheels": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/wheel_id"
      },
      "minItems": 4,
      "maxItems": 8,
      "uniqueItems": true
    },
    "soil_slip_scale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "solar_panel_w": {
      "type": "number",
      "minimum": 0
    },
    "rtg_w": {
      "type": "number",
      "minimum": 0
    },
    "control_period_s": {
      "enum": [
        0.2,
        0.5,
        1.0
      ]
    },
    "pose_noise_scale": {
      "type": "number",
      "minimum": 0
    },
    "has_sample_tool": {
      "type": "boolean"
    },
    "instrument_power_w": {
      "type": "number",
      "minimum": 0
    },
    "design_report": {
      "type": "object"
    },
    "geometry": {
      "description": "Wheel layout for backends that model wheels. Body frame: +X forward, +Y left, +Z up, origin on the ground.",
      "type": "object",
      "properties": {
        "frame": {
          "const": "body_flu"
        },
        "wheels": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "wheel_id": {
                "type": "string"
              },
              "position_m": {
                "$ref": "common.schema.json#/$defs/vector3"
              },
              "radius_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "width_m": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "wheel_id",
              "position_m",
              "radius_m",
              "width_m"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "frame",
        "wheels"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "rover_id",
    "description",
    "mass_kg",
    "body_radius_m",
    "wheel_radius_m",
    "max_speed_mps",
    "max_yaw_rate_radps",
    "max_accel_mps2",
    "max_yaw_accel_radps2",
    "max_climb_slope",
    "battery_capacity_wh",
    "idle_power_w",
    "rolling_resistance",
    "drive_efficiency",
    "turn_power_w_per_radps",
    "base_slip_fraction",
    "slope_slip_factor",
    "slip_noise",
    "failed_wheel_yaw_bias_radps",
    "range_sensor"
  ],
  "additionalProperties": false
}
