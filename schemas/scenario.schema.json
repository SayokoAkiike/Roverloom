{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roverloom.invalid/schemas/scenario.schema.json",
  "title": "Scenario",
  "description": "A mission plus the environment, faults, communications, and sensors it runs under. Never given to agents.",
  "type": "object",
  "$defs": {
    "fault": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "wheel_drive_failure"
            },
            "wheel": {
              "$ref": "common.schema.json#/$defs/wheel_id"
            },
            "start_time_s": {
              "type": "number",
              "minimum": 0
            },
            "category": {
              "description": "mars_inspired means a plausible kind of event with game values, not measured rates. stress_test is deliberately artificial.",
              "enum": [
                "mars_inspired",
                "stress_test"
              ]
            }
          },
          "required": [
            "type",
            "wheel",
            "start_time_s"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "comm_blackout",
                "sensor_dropout",
                "dust_storm",
                "slip_burst",
                "immobilized",
                "power_brownout",
                "sensor_noise_burst"
              ]
            },
            "start_time_s": {
              "type": "number",
              "minimum": 0
            },
            "duration_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "category": {
              "description": "mars_inspired means a plausible kind of event with game values, not measured rates. stress_test is deliberately artificial.",
              "enum": [
                "mars_inspired",
                "stress_test"
              ]
            },
            "severity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "start_time_s",
            "duration_s"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "tier": {
      "description": "practice scenarios are public. evaluation scenarios must stay outside this repository.",
      "enum": [
        "practice",
        "evaluation"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "rover_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "mission": {
      "$ref": "mission.schema.json"
    },
    "environment": {
      "type": "object",
      "properties": {
        "gravity_mps2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "solar_factor": {
          "description": "Game multiplier on nominal panel output for this site and season.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "gravity_mps2"
      ],
      "additionalProperties": false
    },
    "faults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fault"
      }
    },
    "fault_generators": {
      "description": "Random faults, drawn from the seed before the mission starts.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "wheel_drive_failure",
              "comm_blackout",
              "sensor_dropout",
              "dust_storm",
              "slip_burst",
              "immobilized",
              "power_brownout",
              "sensor_noise_burst"
            ]
          },
          "rate_per_hour": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max_count": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "description": "mars_inspired means a plausible kind of event with game values, not measured rates. stress_test is deliberately artificial.",
            "enum": [
              "mars_inspired",
              "stress_test"
            ]
          },
          "severity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "type",
          "rate_per_hour"
        ],
        "additionalProperties": false
      }
    },
    "comms": {
      "type": "object",
      "properties": {
        "latency_s": {
          "type": "number",
          "minimum": 0
        },
        "loss_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "latency_s",
        "loss_probability"
      ],
      "additionalProperties": false
    },
    "sensors": {
      "type": "object",
      "properties": {
        "pose_noise_m": {
          "type": "number",
          "minimum": 0
        },
        "yaw_noise_rad": {
          "type": "number",
          "minimum": 0
        },
        "speed_noise_mps": {
          "type": "number",
          "minimum": 0
        },
        "range_noise_m": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "pose_noise_m",
        "yaw_noise_rad",
        "speed_noise_mps",
        "range_noise_m"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    },
    "uncertainty": {
      "description": "Real sensor errors, and what the agent is told about them. They may disagree on purpose. Only 'declared' reaches agents.",
      "type": "object",
      "properties": {
        "inspection_noise_sd": {
          "type": "number",
          "minimum": 0
        },
        "pose_bias_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "range_bias_m": {
          "type": "number"
        },
        "declared": {
          "type": "object",
          "properties": {
            "inspection_noise_sd": {
              "type": "number",
              "minimum": 0
            },
            "pose_noise_m": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "inspection_noise_sd",
            "pose_noise_m"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "declared"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "seed",
    "mission",
    "environment",
    "faults"
  ],
  "additionalProperties": false
}
